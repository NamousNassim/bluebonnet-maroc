# Bluebonnet sites, imported by the host's Caddy (see deploy/README.md). Containers are reached by
# name over the external "shared-edge" Docker network. Certificates are issued automatically.

www.bluebonnetmaroc.com {
	redir https://bluebonnetmaroc.com{uri} permanent
}

(bluebonnet_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(bluebonnet_private) {
	# The management API is machine-to-machine over the private "sales-channels" Docker network only.
	# /api/api/* covers the storefront's /api proxy prefix as well (defense in depth).
	@bluebonnet_private path /api/internal/* /api/api/*
	respond @bluebonnet_private "Not found" 404
}

bluebonnetmaroc.com {
	import bluebonnet_headers
	import bluebonnet_private
	encode zstd gzip
	reverse_proxy bluebonnet-frontend:3000
}

api.bluebonnetmaroc.com {
	import bluebonnet_headers
	encode zstd gzip
	import bluebonnet_private
	reverse_proxy bluebonnet-api:4000
}
