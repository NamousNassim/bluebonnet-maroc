// Bluebonnet owns merchandising, carts, checkout and customer-facing orders.
// Stock is never stored here: availability always comes from StartEntreprise.
// Money is stored in centimes (MAD) as integers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(120)
  nameFr        String    @map("name_fr") @db.VarChar(120)
  nameAr        String?   @map("name_ar") @db.VarChar(120)
  descriptionFr String?   @map("description_fr")
  descriptionAr String?   @map("description_ar")
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products      Product[]

  @@index([active, sortOrder])
  @@map("categories")
}

model Product {
  id                         String         @id @default(uuid()) @db.Uuid
  /// Stable StartEntreprise ERP catalogue item id — the only link to StartEntreprise.
  startEntrepriseCatalogueId String         @unique @map("startentreprise_catalogue_id") @db.Uuid
  slug                       String         @unique @db.VarChar(160)
  nameFr                     String         @map("name_fr") @db.VarChar(200)
  nameAr                     String?        @map("name_ar") @db.VarChar(200)
  shortDescriptionFr         String?        @map("short_description_fr") @db.VarChar(400)
  shortDescriptionAr         String?        @map("short_description_ar") @db.VarChar(400)
  descriptionFr              String?        @map("description_fr")
  descriptionAr              String?        @map("description_ar")
  sku                        String?        @unique @db.VarChar(100)
  priceCents                 Int            @map("price_cents")
  compareAtPriceCents        Int?           @map("compare_at_price_cents")
  categoryId                 String         @map("category_id") @db.Uuid
  category                   Category       @relation(fields: [categoryId], references: [id])
  active                     Boolean        @default(true)
  published                  Boolean        @default(false)
  featured                   Boolean        @default(false)
  sortOrder                  Int            @default(0) @map("sort_order")
  seoTitle                   String?        @map("seo_title") @db.VarChar(200)
  seoDescription             String?        @map("seo_description") @db.VarChar(320)
  publishedAt                DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  images                     ProductImage[]
  cartItems                  CartItem[]

  @@index([published, active, categoryId])
  @@index([published, active, featured, sortOrder])
  @@index([published, active, publishedAt])
  @@map("products")
}

/// Images live in object storage / static hosting; only URLs are stored.
model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(500)
  altFr     String  @map("alt_fr") @db.VarChar(200)
  altAr     String? @map("alt_ar") @db.VarChar(200)
  position  Int     @default(0)

  @@unique([productId, position])
  @@map("product_images")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

/// Anonymous cart identified by an opaque cookie token; only the token's SHA-256 is stored.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String     @unique @map("token_hash") @db.Char(64)
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     CartItem[]
  checkouts CheckoutSession[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum CheckoutStatus {
  CREATED
  /// Claimed by one confirmation; prevents two concurrent confirmations from both reserving.
  RESERVING
  RESERVED
  FAILED
  EXPIRED
  COMPLETED
}

/// One checkout attempt. Its reference is the StartEntreprise reservation externalReference,
/// so a retry of the same attempt can never reserve twice.
model CheckoutSession {
  id                   String                @id @default(uuid()) @db.Uuid
  reference            String                @unique @db.VarChar(40)
  cartId               String                @map("cart_id") @db.Uuid
  cart                 Cart                  @relation(fields: [cartId], references: [id])
  status               CheckoutStatus        @default(CREATED)
  firstName            String                @map("first_name") @db.VarChar(80)
  lastName             String                @map("last_name") @db.VarChar(80)
  email                String                @db.VarChar(254)
  phone                String                @db.VarChar(30)
  addressLine          String                @map("address_line") @db.VarChar(300)
  city                 String                @db.VarChar(100)
  postalCode           String?               @map("postal_code") @db.VarChar(10)
  notes                String?               @db.VarChar(1000)
  /// Priced snapshot of the cart when the attempt started (backend prices only).
  lines                Json
  subtotalCents        Int                   @map("subtotal_cents")
  shippingCents        Int                   @map("shipping_cents")
  totalCents           Int                   @map("total_cents")
  reservationExpiresAt DateTime?             @map("reservation_expires_at") @db.Timestamptz(3)
  failureCode          String?               @map("failure_code") @db.VarChar(80)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservations         CheckoutReservation[]
  order                Order?

  @@index([cartId])
  @@index([status, reservationExpiresAt])
  @@map("checkout_sessions")
}

enum ReservationLineStatus {
  ACTIVE
  RELEASED
  RELEASE_FAILED
  /// Lapsed at StartEntreprise (TTL) without payment.
  EXPIRED
}

/// Each StartEntreprise reservation taken for a checkout, so compensation is durable and auditable.
model CheckoutReservation {
  id                           String                @id @default(uuid()) @db.Uuid
  checkoutId                   String                @map("checkout_id") @db.Uuid
  checkout                     CheckoutSession       @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  productId                    String                @map("product_id") @db.Uuid
  catalogueItemId              String                @map("catalogue_item_id") @db.Uuid
  quantity                     Int
  startEntrepriseReservationId String                @map("startentreprise_reservation_id") @db.Uuid
  status                       ReservationLineStatus @default(ACTIVE)
  expiresAt                    DateTime              @map("expires_at") @db.Timestamptz(3)
  createdAt                    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([checkoutId, catalogueItemId])
  @@index([status])
  @@map("checkout_reservations")
}

enum OrderStatus {
  PENDING
  CANCELLED
}

/// Customer-facing order. Every commercial value is a snapshot; nothing is recomputed later.
model Order {
  id                String          @id @default(uuid()) @db.Uuid
  orderNumber       String          @unique @map("order_number") @db.VarChar(30)
  checkoutSessionId String          @unique @map("checkout_session_id") @db.Uuid
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  /// Reserved for future customer accounts; guest checkout leaves it null.
  customerId        String?         @map("customer_id") @db.Uuid
  status            OrderStatus     @default(PENDING)
  currency          String          @default("MAD") @db.Char(3)
  firstName         String          @map("first_name") @db.VarChar(80)
  lastName          String          @map("last_name") @db.VarChar(80)
  email             String          @db.VarChar(254)
  phone             String          @db.VarChar(30)
  addressLine       String          @map("address_line") @db.VarChar(300)
  city              String          @db.VarChar(100)
  postalCode        String?         @map("postal_code") @db.VarChar(10)
  notes             String?         @db.VarChar(1000)
  subtotalCents     Int             @map("subtotal_cents")
  shippingCents     Int             @map("shipping_cents")
  totalCents        Int             @map("total_cents")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  items             OrderItem[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String  @map("product_id") @db.Uuid
  productName    String  @map("product_name") @db.VarChar(200)
  sku            String? @db.VarChar(100)
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int     @map("line_total_cents")

  @@map("order_items")
}
