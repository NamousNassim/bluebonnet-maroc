# Production values for /opt/bluebonnet/secrets/bluebonnet.env (chmod 600, never committed).
# Used by: docker compose -f deploy/compose.prod.yml --env-file secrets/bluebonnet.env ...

# Generate with: openssl rand -hex 32   (hex only: it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=change-me-hex-only
PUBLIC_SITE_URL=https://bluebonnetmaroc.com
IMAGE_HOST=

SHIPPING_FLAT_CENTS=3000
FREE_SHIPPING_THRESHOLD_CENTS=80000
LOW_STOCK_DISPLAY_THRESHOLD=5
AVAILABILITY_CACHE_SECONDS=30
RESERVATION_TTL_SECONDS=900

# Enable integration only after mapping preflight and the one-product smoke test; checkout remains a separate decision.
CHECKOUT_ENABLED=false
STARTENTREPRISE_INTEGRATION_ENABLED=false
STARTENTREPRISE_API_URL=https://api.startentreprise.ma
STARTENTREPRISE_TOKEN_URL=https://auth.startentreprise.ma/realms/startentreprise/protocol/openid-connect/token
STARTENTREPRISE_CLIENT_ID=bluebonnet-storefront
# Issued by StartEntreprise for the Bluebonnet client (client credentials). Never NEXT_PUBLIC_*.
STARTENTREPRISE_CLIENT_SECRET=change-me
STARTENTREPRISE_TIMEOUT_MS=5000
# Never seed placeholder products in production.
SEED_DEMO_PRODUCTS=false

# Host directory outside the source tree, mounted into the scheduled backup container.
BACKUP_DIR=/opt/bluebonnet/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
