# Local development (backend reads these; copy to backend/.env or export them).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bluebonnet:bluebonnet-dev@127.0.0.1:55432/bluebonnet
PUBLIC_SITE_URL=http://localhost:3000
CART_COOKIE_SECURE=false
SHIPPING_FLAT_CENTS=3000
FREE_SHIPPING_THRESHOLD_CENTS=80000
CHECKOUT_ENABLED=false
RESERVATION_TTL_SECONDS=900
LOW_STOCK_DISPLAY_THRESHOLD=5
AVAILABILITY_CACHE_SECONDS=30
# Keep disabled until StartEntreprise exposes the public inventory API (docs/startentreprise-public-api-contract.md).
STARTENTREPRISE_INTEGRATION_ENABLED=false
STARTENTREPRISE_API_URL=
STARTENTREPRISE_TOKEN_URL=
STARTENTREPRISE_CLIENT_ID=
STARTENTREPRISE_CLIENT_SECRET=
STARTENTREPRISE_TIMEOUT_MS=5000
# Demo products for local browsing (seed only).
SEED_DEMO_PRODUCTS=true

# Storefront (frontend). Server-side only: never prefix secrets with NEXT_PUBLIC_.
INTERNAL_API_URL=http://localhost:4000
IMAGE_HOST=
